<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Spellwork2.ViewModels"
             x:Class="Spellwork2.Views.SpellInfoView"
             x:DataType="vm:SpellInfoViewModel">

    <Design.DataContext>
        <vm:SpellInfoViewModel />
    </Design.DataContext>

    <Grid  ShowGridLines="False"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*"
          IsVisible="True">

        <!-- Header -->
        <TextBlock Text="SpellInfo"
                   FontWeight="Bold"
                   Grid.Row="0" />

        <!-- Spell Id and name -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Spacing="5">
            <SelectableTextBlock FontWeight="Bold">
                <Run Text="ID: "/>
                <Run Text="{Binding SpellId, StringFormat={}{0} - }"/>
                <Run Text="{Binding FullName}"/>
            </SelectableTextBlock>
        </StackPanel>

        <!-- Tooltips -->
        <Expander Grid.Row="2"
                  Header="Tooltips"
                  HorizontalAlignment="Stretch"
                  Margin="0,5"
                  IsExpanded="True">

            <Expander.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="HasSpellDescription" />
                    <Binding Path="HasAuraDescription" />
                </MultiBinding>
            </Expander.IsVisible>

            <StackPanel>
                <TextBlock Text="Spell" FontWeight="Bold" />
                <SelectableTextBlock Text="{Binding Description}"
                                     IsVisible="{Binding HasSpellDescription}"
                                     TextWrapping="Wrap" />

                <TextBlock Text="Aura" FontWeight="Bold"
                           IsVisible="{Binding HasAuraDescription}"
                           Margin="0,10,0,0" />
                <SelectableTextBlock Text="{Binding AuraDescription}"
                                     IsVisible="{Binding HasAuraDescription}"
                                     TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <!-- SpellMisc-->
        <Expander Grid.Row="3"
                  Header="Misc"
                  HorizontalAlignment="Stretch"
                  Margin="0,5"
                  IsExpanded="True">

            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
                      ShowGridLines="False" ColumnSpacing="10">
                    
                    <!-- SpellFamily -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="SpellFamily" 
                               FontWeight="DemiBold"/>
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1">
                        <Run Text="{Binding SpellFamily}"/>
                        <Run Text="{Binding SpellFamilyId, StringFormat={}({0})}"/>
                    </SelectableTextBlock>
                    
                    <!-- SpellFamilyMask -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="SpellFamilyMask" 
                               FontWeight="DemiBold" 
                               IsVisible="{Binding HasSpellFamily}"/>
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasSpellFamily}">
                        <Run Text="{Binding SpellClassMasks[0], StringFormat={}0x{0:X8} - }" />
                        <Run Text="{Binding SpellClassMasks[1], StringFormat={}0x{0:X8} - }" />
                        <Run Text="{Binding SpellClassMasks[2], StringFormat={}0x{0:X8} - }" />
                        <Run Text="{Binding SpellClassMasks[3], StringFormat={}0x{0:X8}}" />
                    </SelectableTextBlock>
                    
                    <!-- SchoolMask -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="SchoolMask" 
                               FontWeight="DemiBold"/>
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1">
                        <Run Text="{Binding SchoolMask}"/>
                        <Run Text="{Binding SchoolMaskInt, StringFormat={}(0x{0:X2})}"/>
                    </SelectableTextBlock>
                    
                    <!-- Spell Scaling -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Has SpellScaling" FontWeight="DemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HasScaling}"/>
                         
                    <!-- Range -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Range" FontWeight="DemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1">
                        <Run Text="{Binding SpellRangeName}"/>
                        <Run Text="{Binding SpellRangeId, StringFormat={}(Id: {0})}"/>
                    </TextBlock>
                    
                    <TextBlock Grid.Row="5" Grid.Column="1">
                        <TextBox.Text>
                            <MultiBinding StringFormat="Enemy: {0} - {1}yds">
                                <Binding Path="MinRange[0]"/>
                                <Binding Path="MaxRange[0]"/>
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBlock>
                    <TextBlock Grid.Row="6" Grid.Column="1">
                        <TextBox.Text>
                            <MultiBinding StringFormat="Friend: {0} - {1}yds">
                                <Binding Path="MinRange[1]"/>
                                <Binding Path="MaxRange[1]"/>
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBlock>
                    
                    <!-- Duration -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Duration" FontWeight="DemiBold" IsVisible="{Binding HasSpellDuration}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" IsVisible="{Binding HasSpellDuration}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}ms (Max: {1}ms) (+{2}ms per level)">
                                <Binding Path="Duration"/>
                                <Binding Path="MaxDuration"/>
                                <Binding Path="DurationPerLevel"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <!-- Cone Degrees-->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Cone Degrees" FontWeight="DemiBold" IsVisible="{Binding HasConeDegrees}"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ConeDegrees}" IsVisible="{Binding HasConeDegrees}"/>
                    
                    <!-- Cone Width-->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Cone Width" FontWeight="DemiBold" IsVisible="{Binding HasConeWidth}"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ConeWidth}" IsVisible="{Binding HasConeWidth}"/>
                    
                    <!-- Max Targets-->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Max. Targets" FontWeight="DemiBold" IsVisible="{Binding HasMaxTargets}"/>
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding MaxTargets}" IsVisible="{Binding HasMaxTargets}"/>
                    
                    <!-- Max Target Level-->
                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Max. Target Level" FontWeight="DemiBold" IsVisible="{Binding HasMaxTargetLevel}"/>
                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding MaxTargetLevel}" IsVisible="{Binding HasMaxTargetLevel}"/>
                    
                </Grid>
                
                <!-- Attributes -->
                <StackPanel IsVisible="{Binding HasAttributes}">
                    <TableView ItemsSource="{Binding Attributes}" Margin="0,20,0,0">
                        <TableView.Columns>
                            <TableViewColumn Header="Attribute" 
                                             Binding="{Binding AttributeTitle}" 
                                             Width="150"/>
                            <TableViewColumn Header="Value" 
                                             Binding="{Binding AttributeValue, 
                                             StringFormat={}0x{0:X8}}" 
                                             Width="150"/>
                            <TableViewColumn Header="Enums" 
                                             Width="Auto">
                                <TableViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <SelectableTextBlock Text="{Binding AttributeNames}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </TableViewColumn.CellTemplate>
                            </TableViewColumn>
                        </TableView.Columns>
                    </TableView>
                </StackPanel>
            </StackPanel>

        </Expander>

        <!-- Effects -->
        <Expander Grid.Row="4"
                  Header="Effects"
                  HorizontalAlignment="Stretch"
                  Margin="0,5"
                  IsExpanded="True">

            <ItemsControl ItemsSource="{Binding SpellEffects}" />
        </Expander>
    </Grid>

</UserControl>