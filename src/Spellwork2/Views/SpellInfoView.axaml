<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Spellwork2.ViewModels"
             x:Class="Spellwork2.Views.SpellInfoView"
             x:DataType="vm:SpellInfoViewModel">

    <Design.DataContext>
        <vm:SpellInfoViewModel />
    </Design.DataContext>

    <Grid  ShowGridLines="False"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*"
          IsVisible="True">

        <!-- Header -->
        <TextBlock Text="SpellInfo"
                   FontWeight="Bold"
                   Grid.Row="0" />

        <!-- Spell Id and name -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    Spacing="5">
            <TextBlock FontWeight="Bold">
                <Run Text="ID: "/>
                <Run Text="{Binding SpellId, StringFormat={}{0} - }"/>
                <Run Text="{Binding FullName}"/>
            </TextBlock>
        </StackPanel>

        <!-- Tooltips -->
        <Expander Grid.Row="2"
                  Header="Tooltips"
                  HorizontalAlignment="Stretch"
                  Margin="0,5"
                  IsExpanded="True">

            <Expander.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="HasSpellDescription" />
                    <Binding Path="HasAuraDescription" />
                </MultiBinding>
            </Expander.IsVisible>

            <StackPanel>
                <TextBlock Text="Spell" FontWeight="Bold" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasSpellDescription}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Aura" FontWeight="Bold"
                           IsVisible="{Binding HasAuraDescription}"
                           Margin="0,10,0,0" />
                <TextBlock Text="{Binding AuraDescription}"
                           IsVisible="{Binding HasAuraDescription}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <!-- SpellMisc-->
        <Expander Grid.Row="3"
                  Header="Misc"
                  HorizontalAlignment="Stretch"
                  Margin="0,5"
                  IsExpanded="True">

            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*"
                      ShowGridLines="False" ColumnSpacing="10">
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SpellFamily" FontWeight="DemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SpellFamily}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SpellFamilyMask" FontWeight="DemiBold" IsVisible="{Binding HasSpellFamily}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasSpellFamily}">
                        <Run Text="{Binding SpellClassMasks[0], StringFormat={}0x{0:X8} - }" />
                        <Run Text="{Binding SpellClassMasks[1], StringFormat={}0x{0:X8} - }" />
                        <Run Text="{Binding SpellClassMasks[2], StringFormat={}0x{0:X8} - }" />
                        <Run Text="{Binding SpellClassMasks[3], StringFormat={}0x{0:X8}}" />
                    </TextBlock>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SchoolMask" FontWeight="DemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SchoolMask}"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Has SpellScaling" FontWeight="DemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ScalesWithLevel}"/>
                </Grid>
                
                <StackPanel IsVisible="{Binding HasAttributes}">
                    <TextBlock Text="Attributes" FontWeight="Bold" />
                    <SelectableTextBlock Text="{Binding AttributesString}"
                                         TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </Expander>

        <!-- Effects -->
        <Expander Grid.Row="4"
                  Header="Effects"
                  HorizontalAlignment="Stretch"
                  Margin="0,5"
                  IsExpanded="True">

            <ItemsControl ItemsSource="{Binding SpellEffects}" />
        </Expander>
    </Grid>

</UserControl>