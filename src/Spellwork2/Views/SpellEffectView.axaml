<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Spellwork2.ViewModels"
             x:Class="Spellwork2.Views.SpellEffectView"
             x:DataType="vm:SpellEffectViewModel">
    
    <Design.DataContext>
        <vm:SpellEffectViewModel />
    </Design.DataContext>
    
    <GroupBox Header="{Binding}" Margin="5">
        <GroupBox.HeaderTemplate>
            <DataTemplate DataType="vm:SpellEffectViewModel">
                <SelectableTextBlock FontWeight="Bold">
                    <SelectableTextBlock.Text>
                        <MultiBinding StringFormat="EFFECT_{0} - {1} ({2})">
                            <Binding Path="EffectIndex"/>
                            <Binding Path="EffectName"/>
                            <Binding Path="Effect"/>
                        </MultiBinding>
                    </SelectableTextBlock.Text>
                </SelectableTextBlock>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        
        <StackPanel>
            <StackPanel Spacing="2" Margin="15,0,0,0">
            <StackPanel>
                <!-- Aura -->
                <StackPanel IsVisible="{Binding HasAura}">
                    <SelectableTextBlock>
                        <Run Text="Aura: " FontWeight="DemiBold"/>
                        <Run Text="{Binding EffectAuraName}"/>
                        <Run Text="{Binding EffectAura, StringFormat=({0})}"/>
                    </SelectableTextBlock>
                    
                    <StackPanel Margin="15,0,0,0">
                        <SelectableTextBlock>
                            <Run Text="Period: " FontWeight="DemiBold"/> 
                            <Run Text="{Binding Period}"/>
                        </SelectableTextBlock>
                    </StackPanel>
                    <TextBlock/>
                </StackPanel>
                
                <!-- Target A-->
                <SelectableTextBlock>
                    <Run Text="TargetA: " FontWeight="DemiBold"/>
                    <Run Text="{Binding ImplicitTargetA}"/>
                    <Run Text="{Binding RadiusA}"/>
                </SelectableTextBlock>
                
                <!-- Target B-->
                <SelectableTextBlock>
                    <Run Text="TargetB: " FontWeight="DemiBold"/>
                    <Run Text="{Binding ImplicitTargetB}"/>
                    <Run Text="{Binding RadiusB}"/>
                </SelectableTextBlock>
                
                <TextBlock/>
                
                <!-- Effect -->
                <StackPanel>
                    <SelectableTextBlock>
                        <Run Text="BasePoints: " FontWeight="DemiBold"/>
                        <Run Text="{Binding BasePoints}"/>
                        <Run Text=" Variance: " FontWeight="DemiBold"/>
                        <Run Text="{Binding Variance}"/>
                        <Run Text=" DieSides: " FontWeight="DemiBold"/>
                        <Run Text="{Binding DieSides}"/>
                    </SelectableTextBlock>
        
                    <SelectableTextBlock TextWrapping="Wrap">
                        <Run Text="MiscValueA: " FontWeight="DemiBold"/>
                        <Run Text="{Binding EffectMiscValues[0]}"/>
                        <Run Text="{Binding MiscValueAInfo}"/>
                    </SelectableTextBlock>
                    
                    <SelectableTextBlock TextWrapping="Wrap">
                        <Run Text="MiscValueB: " FontWeight="DemiBold"/>
                        <Run Text="{Binding EffectMiscValues[1]}"/>
                        <Run Text="{Binding MiscValueBInfo}"/>
                    </SelectableTextBlock>
                    
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding HasTriggerSpell}">
                        <TextBlock Text="TriggerSpell:" FontWeight="DemiBold" VerticalAlignment="Center"/>
                        <HyperlinkButton Name="TriggerSpellHyperlink"
                                         Command="{Binding SelectSpellFromList}"
                                         CommandParameter="{Binding TriggerSpell}"
                                         ToolTip.Tip="Opens the spell info for this spell if exists">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ({1})">
                                        <Binding Path="TriggerSpell"/> 
                                        <Binding Path="TriggerSpellName"/> 
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </HyperlinkButton>
                    </StackPanel>
                    
                    <SelectableTextBlock IsVisible="{Binding CreatesItem}">
                        <Run Text="Created Item: " FontWeight="DemiBold"/>
                        <Run Text="{Binding EffectItemType}"/>
                        <Run Text="{Binding ItemTypeName, StringFormat=({0})}"/>
                    </SelectableTextBlock>

                </StackPanel>
                
            </StackPanel>
        </StackPanel>
        
            <TextBlock/>
            
        </StackPanel>
    </GroupBox>
</UserControl>
