<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spellwork2.App"
             xmlns:local="using:Spellwork2"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" RegionColor="#1E1E1E" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Generic.axaml"/>
        
        <Style Selector="NotificationCard">
            <Setter Property="Width" Value="500" />
            <Setter Property="MaxWidth" Value="500" />
        </Style>
        
        <Style Selector="TreeDataGrid /template/ ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        
        <Style Selector="Expander">
            <Style.Resources>
                <SolidColorBrush x:Key="ExpanderHeaderBackground">#CCCCCC</SolidColorBrush>
                <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#CCCCCC</SolidColorBrush>
                <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#CCCCCC</SolidColorBrush>
                
                <!-- <SolidColorBrush x:Key="ExpanderHeaderForeground">#FFFFFF</SolidColorBrush> -->
                <!-- <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver">#FFFFFF</SolidColorBrush> -->
                <!-- <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed">#FFFFFF</SolidColorBrush> -->
                
                <SolidColorBrush x:Key="ExpanderContentBackground">#FFFFFF</SolidColorBrush>
                <SolidColorBrush x:Key="ExpanderContentBorderBrush">#E0E0E0</SolidColorBrush>
            </Style.Resources>
        </Style>
        
    </Application.Styles>
</Application>
