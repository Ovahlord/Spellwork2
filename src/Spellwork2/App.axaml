<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spellwork2.App"
             xmlns:local="using:Spellwork2"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
             
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

     <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.ThemeDictionaries>
                 
                 <ResourceDictionary x:Key="Default">
                     <SolidColorBrush x:Key="ExpanderHeaderBackground">#CCCCCC</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#CCCCCC</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#CCCCCC</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderContentBackground">#FFFFFF</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderContentBorderBrush">#E0E0E0</SolidColorBrush>
                 </ResourceDictionary>
                 
                 <ResourceDictionary x:Key="Dark">
                     <SolidColorBrush x:Key="ExpanderHeaderBackground">#333333</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#333333</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#333333</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderContentBackground">#1E1E1E</SolidColorBrush>
                     <SolidColorBrush x:Key="ExpanderContentBorderBrush">#808080</SolidColorBrush>
                 </ResourceDictionary>        
                 
             </ResourceDictionary.ThemeDictionaries>
         </ResourceDictionary>
     </Application.Resources>
             
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" RegionColor="#1E1E1E"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Generic.axaml"/>
        
        <Style Selector="NotificationCard">
            <Setter Property="Width" Value="500" />
            <Setter Property="MaxWidth" Value="500" />
        </Style>
        
        <Style Selector="TreeDataGrid /template/ ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        
    </Application.Styles>
             
</Application>
